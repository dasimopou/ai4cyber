      },
      "name": "Exploitation of Remote Services",
      "tactic_id": "TA0008",
      "tactic_ref": "x-mitre-tactic--7141578b-e50b-4dcc-bfa4-08a8dd689e9e",
      "technique_id": "T1210",
      "technique_ref": "attack-pattern--9db0cf3a-a3c9-4012-8268-123b9db6fd82",
      "description": "Gaining access to the domain controller is one of the primary goals of Russian threat groups. The attack graph attempts to exploit the Zerologon vulnerability to gain domain administrator privileges.",
      "effect_refs": [
        "attack-action--4d758193-8e4a-44de-a417-154ffcece5fa"
      ]
