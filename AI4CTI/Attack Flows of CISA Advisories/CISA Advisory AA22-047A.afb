izontal_elbow","children":["b0f4e21c-0ca4-4c47-a470-d00a84ee9f80","17a34228-d26a-48b9-a779-488a8f57a37c","a54926bb-86a2-4bc1-882e-3dbbc27065f9"],"properties":[]},{"id":"0ba39efe-6f1e-490a-a3ec-19bc2c30fb1d","x":1360,"y":-60,"attrs":256,"template":"action","children":["55e7ea82-69ec-4155-b8a4-1e726c844300","c0f9ffb0-1e61-4acd-a3e4-5e0e5f694a4e","687afb63-ebb5-4695-94c9-a9b5f07b1c6f","08e5b5a5-4c69-4489-b0a9-2ec07b9d32d4","97102320-0b23-4b92-af76-c02e436dd01a","28eccfae-925a-4560-8051-b8ecfc8bc4fb","ce709d3b-d25f-4342-b5e1-c88493ca107a","9d022f5e-0fc3-4da6-836c-5b983511146b","832b8312-87d7-4739-acbc-ba73ea43a819","06851101-03be-4cb7-bc2d-6b38b01ed1d1","7bf185e1-d365-40d6-aeb8-4d2aca184e22","afee9dee-f24a-4e12-b02e-65c0729cca23"],"properties":[["name","OS Credential Dumping"],["tactic_id","TA0006"],["tactic_ref","x-mitre-tactic--2558fd61-8c75-4730-94c4-11926db2a263"],["technique_id","T1003"],["technique_ref","attack-pattern--0a3ead4e-6d47-4ccb-854c-a6a4f9d96b22"],["description","The attack graph continues by using a PowerShell version of Mimikatz to dump all available credentials that could be used by the actor to move from their initial foothold to the rest of the target environment."],["confidence",null],["execution_start",null],["execution_end",null]]},{"id":"388eae33-a654-4f51-98e8-33fe62097bc1","x":1045,"y":-60,"attrs":0,"template":"@__builtin__line_horizontal_elbow","children":["af6328a5-85a0-48a3-9ac4-138fe58a39ff","2954650b-9580-4209-ad21-f05f6d29c1b9","30279063-888b-4d46-8755-06bb9fa08571"],"properties":[]},{"id":"7efee318-e118-427c-82bc-8f6e6333fe5e","x":1920,"y":-60,"attrs":256,"template":"action","children":["4a694852-e854-4441-88d5-87bf1d03353e","93e4fd26-2c3f-428b-907c-b13dff52c155","10c33920-51f1-4d5f-9ffd-252ccd0285f2","9b40b3db-4804-492d-9a52-c4f970dec113","9f316087-d5cf-4db4-b608-cd6c7d6a9070","5fd471e9-754f-4110-b58d-ebacd3950d01","c1dfd278-c94e-43a0-8e0b-839b755b3c92","0c6e97dd-e97b-4e7b-bdf2-75267a50e22f","3a7f8241-44ea-4fb4-b8db-7517c246ff8c","76f